generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model users {
  id                  String               @id @db.Uuid
  email               String               @unique
  full_name           String
  auth_provider_id    String?
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  deleted_at          DateTime?            @db.Timestamptz(6)
  role                user_role
  answers              answers[]
  portal_notifications portal_notifications[]
  marking_reviews      marking_reviews[]
  educators            educators?
  entrants             entrants?
  invites_sent         olympiad_invites[]     @relation("invited_by")
  invites_received     olympiad_invites[]     @relation("invitee")
  school_invitations_sent school_invitations[] @relation("school_invitation_sender")
  school_invitation_used  school_invitations[] @relation("school_invitation_user")
  olympiads            olympiads[]
  school_memberships   school_memberships[]
}

// An invitation to take part in an olympiad, delivered in-app rather than by
// email: anyone can sign up on their own, and an invite simply appears on the
// invitee's dashboard for them to accept or reject.
model olympiad_invites {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  olympiad_id   String           @db.Uuid
  school_id     String?          @db.Uuid
  invitee_id    String           @db.Uuid
  invited_by_id String           @db.Uuid
  role          user_role
  status        invite_status    @default(pending)
  message       String?
  created_at    DateTime         @default(now()) @db.Timestamptz(6)
  responded_at  DateTime?        @db.Timestamptz(6)
  olympiads     olympiads        @relation(fields: [olympiad_id], references: [id], onDelete: Cascade)
  schools       schools?         @relation(fields: [school_id], references: [id], onDelete: Cascade)
  invitee       users            @relation("invitee", fields: [invitee_id], references: [id], onDelete: Cascade)
  invited_by    users            @relation("invited_by", fields: [invited_by_id], references: [id], onDelete: Cascade)

  @@unique([olympiad_id, invitee_id])
  @@index([invitee_id, status])
  @@index([olympiad_id, status])
  @@index([school_id])
}

model schools {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  address              String?
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  educators            educators[]
  entrants             entrants[]
  olympiad_invites     olympiad_invites[]
  school_registrations school_registrations[]
  school_memberships   school_memberships[]
  school_invitations   school_invitations[]
}

// A one-use code for an approved educator or student signup. Organisers may
// invite educators; active school educators can invite educators and students.
// Email + account type + school must match at redemption. The code is hashed.
model school_invitations {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id     String      @db.Uuid
  email         String
  code_hash     String      @unique
  role          school_role?
  account_type  user_role
  invited_by_id String      @db.Uuid
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  expires_at    DateTime    @db.Timestamptz(6)
  used_at       DateTime?   @db.Timestamptz(6)
  used_by_id    String?     @db.Uuid
  revoked_at    DateTime?   @db.Timestamptz(6)
  schools       schools     @relation(fields: [school_id], references: [id], onDelete: Cascade)
  invited_by    users       @relation("school_invitation_sender", fields: [invited_by_id], references: [id], onDelete: Cascade)
  used_by       users?      @relation("school_invitation_user", fields: [used_by_id], references: [id], onDelete: SetNull)

  @@index([school_id, created_at])
  @@index([email])
}

model school_memberships {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String            @db.Uuid
  school_id  String            @db.Uuid
  role       school_role
  status     membership_status @default(active)
  created_at DateTime          @default(now()) @db.Timestamptz(6)
  users      users             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  schools    schools           @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@unique([user_id, school_id])
  @@index([school_id, role, status])
}

model educators {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String                  @unique @db.Uuid
  school_id             String                  @db.Uuid
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  schools               schools                 @relation(fields: [school_id], references: [id])
  users                 users                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  entrant_registrations entrant_registrations[]
  submissions           submissions[]

  @@index([school_id])
}

model entrants {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String?                 @unique @db.Uuid
  school_id             String                  @db.Uuid
  full_name             String
  grade                 String?
  external_ref          String?
  status                membership_status       @default(active)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  entrant_registrations entrant_registrations[]
  schools               schools                 @relation(fields: [school_id], references: [id])
  users                 users?                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  results               results[]
  remark_requests       remark_requests[]
  submissions           submissions[]
  exam_assignments      exam_assignments[]

  @@index([school_id, full_name])
  @@index([school_id, external_ref])
  @@index([school_id, status])
}

model olympiads {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  organiser_id         String                 @db.Uuid
  timezone             String                 @default("Africa/Johannesburg")
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  olympiad_invites     olympiad_invites[]
  users                users                  @relation(fields: [organiser_id], references: [id], onDelete: Cascade)
  rounds               rounds[]
  school_registrations school_registrations[]
  notification_rules   notification_rules[]

  @@index([organiser_id])
}

model notification_rules {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  olympiad_id     String                 @db.Uuid
  name            String
  trigger         notification_trigger
  offset_minutes  Int                    @default(0)
  recipient       notification_recipient
  channel         notification_channel   @default(in_app)
  action          String                 @default("notify_recipients")
  condition       String?
  enabled         Boolean                @default(true)
  created_at      DateTime               @default(now()) @db.Timestamptz(6)
  updated_at      DateTime               @updatedAt @db.Timestamptz(6)
  olympiads       olympiads              @relation(fields: [olympiad_id], references: [id], onDelete: Cascade)
  portal_notifications portal_notifications[]

  @@index([olympiad_id, enabled])
}

// One row per notification email actually sent, keyed by
// (dedup_key, round, recipient) so the dispatcher never sends
// the same notification twice.  dedup_key is "rule:<rule id>"
// for organiser-configured rules and "default:<trigger>" for
// the built-in educator notifications.
model sent_notifications {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dedup_key String
  round_id  String   @db.Uuid
  recipient String
  sent_at   DateTime @default(now()) @db.Timestamptz(6)
  rounds    rounds   @relation(fields: [round_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([dedup_key, round_id, recipient])
  @@index([round_id])
}

model school_registrations {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id     String              @db.Uuid
  olympiad_id   String              @db.Uuid
  registered_at DateTime            @default(now()) @db.Timestamptz(6)
  status        registration_status @default(approved)
  olympiads     olympiads           @relation(fields: [olympiad_id], references: [id])
  schools       schools             @relation(fields: [school_id], references: [id])

  @@unique([school_id, olympiad_id])
  @@index([olympiad_id])
}

model rounds {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  olympiad_id           String                  @db.Uuid
  name                  String
  notes                 String?
  opens_at              DateTime                @db.Timestamptz(6)
  closes_at             DateTime                @db.Timestamptz(6)
  // When the round actually closed (the lifecycle job or an organiser), so a
  // submission that arrived before that moment still counts
  closed_at             DateTime?               @db.Timestamptz(6)
  results_release_at    DateTime?               @db.Timestamptz(6)
  state                 round_state             @default(scheduled)
  exam_status           exam_status             @default(draft)
  approved_by           String?                 @db.Uuid
  approved_at           DateTime?               @db.Timestamptz(6)
  qualifying_threshold  Decimal?                @db.Decimal
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  entrant_registrations entrant_registrations[]
  papers                papers[]
  results               results[]
  sent_notifications    sent_notifications[]
  olympiads             olympiads               @relation(fields: [olympiad_id], references: [id], onDelete: Cascade)
  submissions           submissions[]
  remark_requests       remark_requests[]
  portal_notifications  portal_notifications[]
  exam_assignments      exam_assignments[]

  @@index([state, opens_at, closes_at], map: "idx_rounds_state_times")
  @@index([olympiad_id, opens_at])
}

model papers {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  round_id      String      @db.Uuid
  title         String
  file_url      String?
  memo_file_url String?
  is_archived   Boolean     @default(false)
  released_at   DateTime?   @db.Timestamptz(6)
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  rounds        rounds      @relation(fields: [round_id], references: [id])
  questions     questions[]

  @@index([round_id])
}

model questions {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paper_id       String    @db.Uuid
  type           String
  prompt         String
  options        Json?
  correct_option String?
  correct_answer String?
  negative_pct   Decimal   @default(0) @db.Decimal
  max_points     Decimal   @default(1) @db.Decimal
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  // A question imported from the bank points at the original it was copied
  // from (never at another copy), so all uses of a question are one family
  source_question_id String?     @db.Uuid
  source_question    questions?  @relation("QuestionCopies", fields: [source_question_id], references: [id], onDelete: SetNull)
  copies             questions[] @relation("QuestionCopies")
  answers        answers[]
  papers         papers    @relation(fields: [paper_id], references: [id], onDelete: Cascade)

  @@index([source_question_id])
  @@index([paper_id])
}

model answers {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submission_id  String      @db.Uuid
  question_id    String      @db.Uuid
  answer_value   String?
  is_correct     Boolean?
  points_awarded Decimal?    @db.Decimal
  marked_by      String?     @db.Uuid
  marked_at      DateTime?   @db.Timestamptz(6)
  users          users?      @relation(fields: [marked_by], references: [id])
  marking_reviews marking_reviews[]
  questions      questions   @relation(fields: [question_id], references: [id])
  submissions    submissions @relation(fields: [submission_id], references: [id], onDelete: Cascade)

  @@unique([submission_id, question_id])
  @@index([question_id])
}

model submissions {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  round_id             String            @db.Uuid
  entrant_id           String            @db.Uuid
  submitted_by         String?           @db.Uuid
  route                submission_route  @default(offline)
  status               submission_status @default(received)
  is_late              Boolean           @default(false)
  idempotency_key      String            @unique
  received_at          DateTime          @default(now()) @db.Timestamptz(6)
  round_close_snapshot DateTime          @db.Timestamptz(6)
  exam_assignment_id   String?           @db.Uuid
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  answers              answers[]
  entrants             entrants          @relation(fields: [entrant_id], references: [id])
  rounds               rounds            @relation(fields: [round_id], references: [id])
  educators            educators?        @relation(fields: [submitted_by], references: [id])
  exam_assignments     exam_assignments?  @relation(fields: [exam_assignment_id], references: [id], onDelete: SetNull)

  // One submission per learner per round, whichever route it came by (A11)
  @@unique([round_id, entrant_id])
  @@index([entrant_id])
  @@index([round_id, status])
}

// A stable, system-generated question/option layout for one entrant's online
// sitting. The option order stores canonical option indexes in displayed order.
model exam_assignments {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  round_id      String       @db.Uuid
  entrant_id    String       @db.Uuid
  question_order Json
  option_orders  Json
  variant_hash   String?
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  rounds         rounds      @relation(fields: [round_id], references: [id], onDelete: Cascade)
  entrants       entrants    @relation(fields: [entrant_id], references: [id], onDelete: Cascade)
  submissions    submissions[]

  @@unique([round_id, entrant_id])
  @@unique([round_id, variant_hash])
  @@index([round_id])
}

model entrant_registrations {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entrant_id    String    @db.Uuid
  round_id      String    @db.Uuid
  registered_by String    @db.Uuid
  status        String    @default("registered")
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  entrants      entrants  @relation(fields: [entrant_id], references: [id])
  educators     educators @relation(fields: [registered_by], references: [id])
  rounds        rounds    @relation(fields: [round_id], references: [id])

  @@unique([entrant_id, round_id])
  @@index([round_id])
}

model results {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  round_id        String            @db.Uuid
  entrant_id      String            @db.Uuid
  total_points    Decimal           @default(0) @db.Decimal
  rank            Int?
  qualified       Boolean           @default(false)
  finalised_at    DateTime?         @db.Timestamptz(6)
  entrants        entrants          @relation(fields: [entrant_id], references: [id])
  rounds          rounds            @relation(fields: [round_id], references: [id])
  remark_requests remark_requests[]

  @@unique([round_id, entrant_id])
  @@index([round_id, rank], map: "idx_results_round_rank")
  @@index([entrant_id])
}

model remark_requests {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  result_id   String        @unique @db.Uuid
  round_id    String?       @db.Uuid
  entrant_id  String?       @db.Uuid
  reason      String
  status      remark_status @default(pending)
  reviewer_id String?       @db.Uuid
  review_note String?
  decision    String?
  decided_at  DateTime?     @db.Timestamptz(6)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  reviewed_at DateTime?     @db.Timestamptz(6)

  results  results   @relation(fields: [result_id], references: [id])
  rounds   rounds?   @relation(fields: [round_id], references: [id])
  entrants entrants? @relation(fields: [entrant_id], references: [id])

  @@index([round_id])
  @@index([entrant_id])
}

enum round_state {
  scheduled
  open
  closed
  marking
  results_released
}

enum submission_route {
  online
  offline
}

enum submission_status {
  received
  automarked
  queued_for_marking
  marked
  moderated
}

enum user_role {
  organiser
  educator
  student
}

enum invite_status {
  pending
  accepted
  rejected
}

enum school_role {
  coordinator
  educator
}

enum membership_status {
  active
  pending
  rejected
  removed
}

enum registration_status {
  pending
  approved
  withdrawn
}

enum exam_status {
  draft
  ready
  live
}

enum notification_trigger {
  missing_submission
  round_opens
  round_closes
  results_released
}

enum notification_recipient {
  registered_educators
  registered_schools
  qualifying_entrants
}

enum notification_channel {
  in_app
  email
}

enum remark_status {
  pending
  reviewed
  approved
  rejected
}

model portal_notifications {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid
  rule_id String? @db.Uuid
  round_id String? @db.Uuid
  dedupe_key String @unique
  title String
  body String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  read_at DateTime? @db.Timestamptz(6)
  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  notification_rules notification_rules? @relation(fields: [rule_id], references: [id], onDelete: SetNull)
  rounds rounds? @relation(fields: [round_id], references: [id], onDelete: Cascade)
  @@index([user_id, created_at])
}


model marking_reviews {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  answer_id String @db.Uuid
  reviewer_id String @db.Uuid
  original_points Decimal @db.Decimal
  revised_points Decimal @db.Decimal
  comment String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  answers answers @relation(fields: [answer_id], references: [id], onDelete: Cascade)
  users users @relation(fields: [reviewer_id], references: [id], onDelete: Cascade)

  @@index([answer_id])
}

// Append-only records survive changes to round state and submission status.
model round_events {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  round_id    String   @db.Uuid
  kind        String
  origin      String
  event_key   String   @unique
  details     Json     @default("{}")
  occurred_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([round_id, occurred_at])
}

model submission_deadline_decisions {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  round_id    String   @db.Uuid
  entrant_id  String   @db.Uuid
  route       String
  accepted    Boolean
  decided_at  DateTime @db.Timestamptz(6)
  closes_at   DateTime @db.Timestamptz(6)
  explanation String

  @@index([round_id, decided_at])
}
