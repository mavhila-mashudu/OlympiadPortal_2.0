generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model users {
  id                  String        @id @db.Uuid
  email               String        @unique
  full_name           String
  auth_provider_id    String?
  created_at          DateTime      @default(now()) @db.Timestamptz(6)
  deleted_at          DateTime?     @db.Timestamptz(6)
  role                user_role
  answers             answers[]
  portal_notifications portal_notifications[]
  remarks_reviewed remark_requests[]
  marking_reviews marking_reviews[]
  educators           educators?
  entrants            entrants?
  invites_sent        olympiad_invites[] @relation("invited_by")
  invites_received    olympiad_invites[] @relation("invitee")
  olympiads           olympiads[]
  school_memberships  school_memberships[]
}

// An invitation to take part in an olympiad, delivered in-app rather than by
// email: anyone can sign up on their own, and an invite simply appears on the
// invitee's dashboard for them to accept or reject.
model olympiad_invites {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  olympiad_id   String           @db.Uuid
  school_id     String?          @db.Uuid
  invitee_id    String           @db.Uuid
  invited_by_id String           @db.Uuid
  role          user_role
  status        invite_status    @default(pending)
  message       String?
  created_at    DateTime         @default(now()) @db.Timestamptz(6)
  responded_at  DateTime?        @db.Timestamptz(6)
  olympiads     olympiads        @relation(fields: [olympiad_id], references: [id], onDelete: Cascade)
  schools       schools?         @relation(fields: [school_id], references: [id], onDelete: Cascade)
  invitee       users            @relation("invitee", fields: [invitee_id], references: [id], onDelete: Cascade)
  invited_by    users            @relation("invited_by", fields: [invited_by_id], references: [id], onDelete: Cascade)

  @@unique([olympiad_id, invitee_id])
  @@index([invitee_id, status])
  @@index([olympiad_id, status])
  @@index([school_id])
}

model schools {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  address              String?
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  educators            educators[]
  entrants             entrants[]
  olympiad_invites     olympiad_invites[]
  school_registrations school_registrations[]
  school_memberships   school_memberships[]
}

model school_memberships {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String            @db.Uuid
  school_id  String            @db.Uuid
  role       school_role
  status     membership_status @default(active)
  created_at DateTime          @default(now()) @db.Timestamptz(6)
  users      users             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  schools    schools           @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@unique([user_id, school_id])
  @@index([school_id, role, status])
}

model educators {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String                  @unique @db.Uuid
  school_id             String                  @db.Uuid
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  schools               schools                 @relation(fields: [school_id], references: [id])
  users                 users                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  entrant_registrations entrant_registrations[]
  submissions           submissions[]
}

model entrants {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String?                 @unique @db.Uuid
  school_id             String                  @db.Uuid
  full_name             String
  grade                 String?
  external_ref          String?
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  entrant_registrations entrant_registrations[]
  schools               schools                 @relation(fields: [school_id], references: [id])
  users                 users?                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  results               results[]
  submissions           submissions[]
  remark_requests       remark_requests[]
}

model olympiads {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  organiser_id         String                 @db.Uuid
  timezone             String                 @default("Africa/Johannesburg")
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  olympiad_invites     olympiad_invites[]
  users                users                  @relation(fields: [organiser_id], references: [id], onDelete: Cascade)
  rounds               rounds[]
  school_registrations school_registrations[]
  notification_rules notification_rules[]
}

model notification_rules {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  olympiad_id     String                 @db.Uuid
  name            String
  trigger         notification_trigger
  offset_minutes  Int                    @default(0)
  recipient       notification_recipient
  channel         notification_channel   @default(in_app)
  condition       String?
  enabled         Boolean                @default(true)
  created_at      DateTime               @default(now()) @db.Timestamptz(6)
  updated_at      DateTime               @updatedAt @db.Timestamptz(6)
  olympiads       olympiads              @relation(fields: [olympiad_id], references: [id], onDelete: Cascade)
  portal_notifications portal_notifications[]

  @@index([olympiad_id, enabled])
}

model school_registrations {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  school_id     String    @db.Uuid
  olympiad_id   String    @db.Uuid
  registered_at DateTime  @default(now()) @db.Timestamptz(6)
  status        registration_status @default(approved)
  olympiads     olympiads @relation(fields: [olympiad_id], references: [id])
  schools       schools   @relation(fields: [school_id], references: [id])

  @@unique([school_id, olympiad_id])
}

model rounds {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  olympiad_id           String                  @db.Uuid
  name                  String
  notes                 String?
  opens_at              DateTime                @db.Timestamptz(6)
  closes_at             DateTime                @db.Timestamptz(6)
  results_release_at    DateTime?               @db.Timestamptz(6)
  state                 round_state             @default(scheduled)
  exam_status           exam_status             @default(draft)
  approved_by           String?                 @db.Uuid
  approved_at           DateTime?               @db.Timestamptz(6)
  qualifying_threshold  Decimal?                @db.Decimal
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  entrant_registrations entrant_registrations[]
  papers                papers[]
  results               results[]
  olympiads             olympiads               @relation(fields: [olympiad_id], references: [id], onDelete: Cascade)
  submissions           submissions[]
  portal_notifications  portal_notifications[]
  remark_requests       remark_requests[]

  @@index([state, opens_at, closes_at], map: "idx_rounds_state_times")
}

model papers {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  round_id      String      @db.Uuid
  title         String
  file_url      String?
  memo_file_url String?
  is_archived   Boolean     @default(false)
  released_at   DateTime?   @db.Timestamptz(6)
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  rounds        rounds      @relation(fields: [round_id], references: [id])
  questions     questions[]
}

model questions {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paper_id       String    @db.Uuid
  type           String
  prompt         String
  options        Json?
  correct_option String?
  correct_answer String?
  negative_pct   Decimal   @default(0) @db.Decimal
  max_points     Decimal   @default(1) @db.Decimal
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  answers        answers[]
  papers         papers    @relation(fields: [paper_id], references: [id], onDelete: Cascade)
}

model answers {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submission_id  String      @db.Uuid
  question_id    String      @db.Uuid
  answer_value   String?
  is_correct     Boolean?
  points_awarded Decimal?    @db.Decimal
  marked_by      String?     @db.Uuid
  marked_at      DateTime?   @db.Timestamptz(6)
  users          users?      @relation(fields: [marked_by], references: [id])
  marking_reviews marking_reviews[]
  questions      questions   @relation(fields: [question_id], references: [id])
  submissions    submissions @relation(fields: [submission_id], references: [id], onDelete: Cascade)

  @@unique([submission_id, question_id])
}

model submissions {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  round_id             String            @db.Uuid
  entrant_id           String            @db.Uuid
  submitted_by         String?           @db.Uuid
  route                submission_route  @default(offline)
  status               submission_status @default(received)
  is_late              Boolean           @default(false)
  idempotency_key      String            @unique
  received_at          DateTime          @default(now()) @db.Timestamptz(6)
  round_close_snapshot DateTime          @db.Timestamptz(6)
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  answers              answers[]
  entrants             entrants          @relation(fields: [entrant_id], references: [id])
  rounds               rounds            @relation(fields: [round_id], references: [id])
  educators            educators?        @relation(fields: [submitted_by], references: [id])

  @@unique([round_id, entrant_id, route])
}

model entrant_registrations {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entrant_id    String    @db.Uuid
  round_id      String    @db.Uuid
  registered_by String    @db.Uuid
  status        String    @default("registered")
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  entrants      entrants  @relation(fields: [entrant_id], references: [id])
  educators     educators @relation(fields: [registered_by], references: [id])
  rounds        rounds    @relation(fields: [round_id], references: [id])

  @@unique([entrant_id, round_id])
}

model results {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  round_id     String    @db.Uuid
  entrant_id   String    @db.Uuid
  total_points Decimal   @default(0) @db.Decimal
  rank         Int?
  qualified    Boolean   @default(false)
  finalised_at DateTime? @db.Timestamptz(6)
  entrants     entrants  @relation(fields: [entrant_id], references: [id])
  rounds       rounds    @relation(fields: [round_id], references: [id])

  @@unique([round_id, entrant_id])
  @@index([round_id, rank], map: "idx_results_round_rank")
}

enum round_state {
  scheduled
  open
  closed
  marking
  results_released
}

enum submission_route {
  online
  offline
}

enum submission_status {
  received
  automarked
  queued_for_marking
  marked
  moderated
}

enum user_role {
  organiser
  educator
  student
}

enum invite_status {
  pending
  accepted
  rejected
}

enum school_role {
  coordinator
  educator
}

enum membership_status {
  active
  removed
}

enum registration_status {
  pending
  approved
  withdrawn
}

enum exam_status {
  draft
  ready
  live
}

enum notification_trigger {
  missing_submission
  round_opens
  round_closes
  results_released
}

enum notification_recipient {
  registered_educators
  registered_schools
  qualifying_entrants
}

enum notification_channel {
  in_app
  email
}

model portal_notifications {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid
  rule_id String? @db.Uuid
  round_id String? @db.Uuid
  dedupe_key String @unique
  title String
  body String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  read_at DateTime? @db.Timestamptz(6)
  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  notification_rules notification_rules? @relation(fields: [rule_id], references: [id], onDelete: SetNull)
  rounds rounds? @relation(fields: [round_id], references: [id], onDelete: Cascade)
  @@index([user_id, created_at])
}

model remark_requests {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  round_id String @db.Uuid
  entrant_id String @db.Uuid
  reason String
  status String @default("pending")
  reviewer_id String? @db.Uuid
  decision String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  decided_at DateTime? @db.Timestamptz(6)
  rounds rounds @relation(fields: [round_id], references: [id], onDelete: Cascade)
  entrants entrants @relation(fields: [entrant_id], references: [id], onDelete: Cascade)
  users users? @relation(fields: [reviewer_id], references: [id], onDelete: SetNull)
  @@unique([round_id, entrant_id])
  @@map("portal_remark_requests")
}

model marking_reviews {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  answer_id String @db.Uuid
  reviewer_id String @db.Uuid
  original_points Decimal @db.Decimal
  revised_points Decimal @db.Decimal
  comment String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  answers answers @relation(fields: [answer_id], references: [id], onDelete: Cascade)
  users users @relation(fields: [reviewer_id], references: [id], onDelete: Cascade)
}
