# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
LIFECYCLE_INTERVAL_MS=
# Optional: requests allowed per IP per 15 minutes on public auth endpoints (default 100)
AUTH_RATE_LIMIT_MAX=
# Optional: requests allowed per IP per 15 minutes on the public developer API, /public (default 300)
PUBLIC_RATE_LIMIT_MAX=

# Database
DATABASE_URL=
# Used by the Prisma CLI (migrations) via prisma.config.ts
DIRECT_URL=

# Supabase (SUPABASE_SERVICE_ROLE_KEY preferred; SUPABASE_SERVICE_KEY is accepted as a fallback)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=

# Email — uses EmailJS REST API (no SMTP server required).
# Create an account at https://www.emailjs.com and fill in the values below.
# Your EmailJS template must expose these variables:
#   {{to_email}}  {{subject}}  {{html_content}}
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_USER_ID=
EMAILJS_PRIVATE_KEY=
