# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
LIFECYCLE_INTERVAL_MS=

# Database
DATABASE_URL=
# Used by the Prisma CLI (migrations) via prisma.config.ts
DIRECT_URL=

# Supabase (SUPABASE_SERVICE_ROLE_KEY preferred; SUPABASE_SERVICE_KEY is accepted as a fallback)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=

# Auth
ORGANISER_SECRET=

# Email — production on Render uses Resend over HTTPS (not SMTP).
# RESEND_FROM must use a domain verified in Resend. During Resend testing, use
# the onboarding sender and send only to the Resend account email.
RESEND_API_KEY=
RESEND_FROM=Olympiad Portal <onboarding@resend.dev>

# Optional local-development SMTP fallback only. Do not rely on SMTP on Render.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Olympiad Portal <no-reply@example.com>
